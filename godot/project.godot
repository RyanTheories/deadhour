; Engine configuration file.
; DEADHOUR — Godot 4 project (Build 0, third-person prototype)
; Tuned for low-end hardware: GL Compatibility renderer, 640x360 internal
; resolution upscaled, CPU particles, simple meshes.

config_version=5

[application]

config/name="DEADHOUR"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

BulletTime="*res://autoload/bullet_time.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=0
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.04, 0.05, 0.08, 1)
